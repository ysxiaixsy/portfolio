# Contact form — copy to .env.local and fill in.
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Where messages are delivered (defaults to site.email in src/data/site.ts).
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend. Without one, Resend's
# onboarding@resend.dev sender only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=


# The site's public address, for canonical links, link previews and the
# sitemap, e.g. https://example.com. On Vercel it defaults to the project's
# production address, so set it only for a custom domain.
NEXT_PUBLIC_SITE_URL=
